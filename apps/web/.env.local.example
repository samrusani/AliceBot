# Browser settings for live continuity-console reads and writes.
# The console enables live mode only for loopback APIs.
# Never place API keys or secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_ALICEBOT_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ALICEBOT_USER_ID=00000000-0000-0000-0000-000000000001

# Server-only compatibility switch. Only the exact string 1 mounts the legacy
# approvals, tasks, Gmail, and Calendar pages. Leave disabled for the default console.
ALICE_LEGACY_SURFACES=0
