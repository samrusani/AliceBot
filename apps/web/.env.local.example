# Browser settings for live operator-console reads and writes.
# The generic console enables live mode only for loopback APIs. Hosted bearer
# panels may use an explicit HTTPS API, but arbitrary remote console targets stay disabled.
# This file contains public browser values only. Never place API keys or secrets here.
NEXT_PUBLIC_ALICEBOT_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ALICEBOT_USER_ID=00000000-0000-0000-0000-000000000001
